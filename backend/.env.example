# ========================================
# MediConnect AI - Backend Configuration
# ========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/telemedicine
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telemedicine?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cloudinary Configuration (Optional - for cloud storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@mediconnect.ai

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Session Configuration
SESSION_SECRET=your-session-secret-key

# Payment Gateway (Optional - for future use)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# SMS Service (Optional - for notifications)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_VIDEO_CALLS=true
ENABLE_AI_ANALYSIS=true
ENABLE_BLOCKCHAIN=true
ENABLE_CHATBOT=true

# ========================================
# IMPORTANT SECURITY NOTES:
# ========================================
# 1. Never commit this file with real values
# 2. Copy this to .env and fill in your values
# 3. Add .env to .gitignore
# 4. Use strong, unique secrets in production
# 5. Rotate secrets regularly
# 6. Use environment-specific configurations
# ========================================
